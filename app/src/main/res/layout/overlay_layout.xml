<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg_primary"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/top_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/overlay_safaricomplus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Safaricom+"
            android:textColor="@android:color/white"
            android:textSize="24dp" />

        <TextView
            android:id="@+id/overlay_mpesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="21dp"
            android:text="M-PESA"
            android:textColor="@android:color/white"
            android:textSize="24dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/overlay_log_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/button_container"
        android:layout_below="@id/top_section"
        android:layout_marginTop="16dp"
        android:background="@color/dark_bg_primary">

        <TextView
            android:id="@+id/overlay_status_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Log starting...\n"
            android:textColor="@android:color/white" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/toggle_log_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toggle Log"
            android:textColor="@android:color/holo_blue_light"
            android:padding="8dp" />

        <TextView
            android:id="@+id/button_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Service"
            android:textColor="@android:color/holo_red_light"
            android:layout_marginStart="16dp"
            android:padding="8dp" />
    </LinearLayout>
</RelativeLayout>
